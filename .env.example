# 小书童网页版生产配置样例。复制为 .env 后按需修改；.env 已被 .gitignore 排除，绝不要提交真实口令。
# 使用方式：set -a; . ./.env; set +a; node server/index.mjs
# Windows PowerShell：逐项 $env:NAME="value" 后执行 node server/index.mjs

NODE_ENV=production
# 对外访问地址，决定 Cookie 的 Secure 标记与 Origin 校验；必须与实际域名一致
PUBLIC_ORIGIN=https://novel.example.com
# 开发时若用 Vite dev server（5180）代理 /api，把它的源加入白名单
ALLOWED_ORIGINS=http://127.0.0.1:5180

# 首次启动创建管理员。生产环境必填，缺失时服务拒绝启动；口令至少 10 位。
# 创建完成后建议从环境变量移除，后续账号用 auth-cli 或管理员 API 管理。
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD

# 目录：DATA_ROOT 放账号库/会话/配额，XST_TENANT_ROOT_BASE 放各账号的作品数据。
# Windows 上租户根必须足够短（作品根目录 + 项目名 <= 85 字符），例如 D:\xst。
DATA_ROOT=/srv/xiaoshutong/data
XST_TENANT_ROOT_BASE=/srv/xiaoshutong/tenants
STATIC_ROOT=/srv/xiaoshutong/dist-web

# 监听：容器里用 0.0.0.0，由外部反向代理提供 HTTPS；本机开发可保持 127.0.0.1
HOST=0.0.0.0
PORT=8787

# 会话有效期（小时）
SESSION_TTL_HOURS=12

# 租户进程池与任务队列
MAX_TENANTS=8
TENANT_IDLE_MS=900000
TENANT_READY_TIMEOUT_MS=60000
MAX_GLOBAL_CONCURRENCY=8
QUEUE_TIMEOUT_MS=60000

# 模型服务凭据由用户在设置页自行填写（BYOK）；服务端不预置任何 API Key。
